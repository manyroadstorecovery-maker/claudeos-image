{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/projects/**)",
      "Write(~/.claude/projects/**)",
      "Edit(/etc/**)",
      "Write(/etc/**)",
      "Edit(/var/log/**)",
      "Write(/var/log/**)",
      "Bash(sudo *)",
      "Bash(pkexec *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "/usr/libexec/claudeos/claudeos-guard", "args": [], "timeout": 15, "onFailure": "block" } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "/usr/libexec/claudeos/claudeos-guard", "args": [], "timeout": 15 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "/usr/libexec/claudeos/claudeos-guard", "args": [], "timeout": 15, "onFailure": "block" } ] }
    ],
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "/usr/libexec/claudeos/claudeos-guard", "args": [], "timeout": 15 } ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "/usr/libexec/claudeos/claudeos-guard", "args": [], "timeout": 15 } ] }
    ]
  }
}
